openapi: 1.0.0
info:
  title: Movie Ticket API
  version: 1.0.0
  description: >
    A very basic API for pulling up movie showtimes  as well as booking and manipulating reservations

paths:
  /showtimes:
    get:
      summary: Find showtimes
      parameters:
        - name: location
          in: query
          required: true
          schema:
            type: string
        - name: date
          in: query
          required: true
          schema:
            type: string
            format: date
      responses:
        "200":
          description: Showtimes found
        "404":
          description: Theater location or showtimes not found

  /reservations:
    post:
      summary: Reserve seats
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [showtimeId, seatIds]
              properties:
                showtimeId:
                  type: string
                seatIds:
                  type: array
                  items:
                    type: string
      responses:
        "201":
          description: Reservation created
        "409":
          description: Seats are unavailable

  /reservations/{reservationId}:
    delete:
      summary: Cancel reservation
      parameters:
        - name: reservationId
          in: path
          required: true
          schema:
            type: string
      responses:
        "204":
          description: Reservation cancelled
        "404":
          description: Reservation not found